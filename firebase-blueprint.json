{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information for authenticated clients.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string", "maxLength": 100 },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "Consultation": {
      "title": "Consultation",
      "description": "Client consultation requests submitted through the contact page.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "maxLength": 30 },
        "serviceType": { "type": "string" },
        "message": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "email", "serviceType", "message", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profiles data."
    },
    "/consultations/{consultationId}": {
      "schema": { "$ref": "Consultation" },
      "description": "Client consultation inquiries."
    }
  }
}
